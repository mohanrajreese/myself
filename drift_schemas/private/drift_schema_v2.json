        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_sensitive_reminders\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"owner_type\" TEXT NOT NULL CHECK(\"owner_type\" IN ('bowel', 'medication', 'private_activity', 'custom')), \"owner_id\" TEXT NULL, \"title\" TEXT NOT NULL, \"schedule\" TEXT NOT NULL, \"quiet_hours_behaviour\" TEXT NOT NULL DEFAULT 'defer', \"snooze_default_min\" INTEGER NOT NULL DEFAULT 10, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
