  "fixed_sql": [
    {
      "name": "local_private_activity_definitions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_private_activity_definitions\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('activity', 'habit')), \"name\" TEXT NOT NULL, \"description\" TEXT NULL, \"icon_key\" TEXT NOT NULL DEFAULT 'lock', \"tracking_type\" TEXT NOT NULL CHECK(\"tracking_type\" IN ('boolean', 'count', 'numeric', 'duration', 'stopwatch', 'event_log', 'checklist')), \"target_milli\" INTEGER NULL, \"target_unit\" TEXT NULL, \"schedule\" TEXT NULL, \"schedule_history\" TEXT NOT NULL DEFAULT '[]', \"checklist_items\" TEXT NOT NULL DEFAULT '[]', \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"system_key\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_private_activity_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_private_activity_logs\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"definition_id\" TEXT NOT NULL REFERENCES local_private_activity_definitions (id) ON DELETE CASCADE, \"status\" TEXT NOT NULL CHECK(\"status\" IN ('completed', 'skipped')), \"occurred_at\" TEXT NOT NULL, \"local_date\" TEXT NOT NULL, \"tz\" TEXT NOT NULL, \"scheduled_slot\" INTEGER NULL, \"count_value\" INTEGER NULL, \"numeric_value_milli\" INTEGER NULL, \"duration_s\" INTEGER NULL, \"checklist_state\" TEXT NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_private_habit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_private_habit_logs\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"definition_id\" TEXT NOT NULL REFERENCES local_private_activity_definitions (id) ON DELETE CASCADE, \"count\" INTEGER NOT NULL CHECK(\"count\" BETWEEN 1 AND 100), \"occurred_at\" TEXT NOT NULL, \"local_date\" TEXT NOT NULL, \"tz\" TEXT NOT NULL, \"note\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_bowel_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_bowel_logs\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"occurred_at\" TEXT NOT NULL, \"local_date\" TEXT NOT NULL, \"tz\" TEXT NOT NULL, \"count\" INTEGER NOT NULL DEFAULT 1 CHECK(\"count\" BETWEEN 1 AND 20), \"consistency\" TEXT NOT NULL CHECK(\"consistency\" IN ('hard', 'normal', 'loose')), \"straining\" INTEGER NOT NULL DEFAULT 0 CHECK (\"straining\" IN (0, 1)), \"pain\" INTEGER NULL CHECK (\"pain\" IN (0, 1)), \"bleeding\" INTEGER NULL CHECK (\"bleeding\" IN (0, 1)), \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_medications",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_medications\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"dosage_text\" TEXT NOT NULL, \"schedule\" TEXT NOT NULL, \"remind\" INTEGER NOT NULL DEFAULT 1 CHECK (\"remind\" IN (0, 1)), \"notes\" TEXT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_medication_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_medication_logs\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"medication_id\" TEXT NOT NULL REFERENCES local_medications (id) ON DELETE CASCADE, \"scheduled_slot\" INTEGER NULL, \"local_date\" TEXT NOT NULL, \"status\" TEXT NOT NULL CHECK(\"status\" IN ('taken', 'missed', 'skipped')), \"acted_at\" TEXT NOT NULL, \"notes\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "local_sensitive_reminders",
